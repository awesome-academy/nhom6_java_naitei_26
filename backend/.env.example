# Container images
MYSQL_IMAGE=mysql:8.0
MINIO_IMAGE=quay.io/minio/minio:latest
REDIS_IMAGE=redis:7.4.10-alpine

# Bind published ports to the local machine only by default
HOST_BIND_ADDRESS=127.0.0.1

# MySQL
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_management
MYSQL_USER=hotel_app
MYSQL_PASSWORD=replace_with_a_strong_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_mysql_root_password

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hotel_minio_admin
MINIO_ROOT_PASSWORD=replace_with_a_strong_minio_password

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_strong_redis_password

# Auth
JWT_SECRET=replace_with_at_least_32_bytes_random_secret
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=7d
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION=15m

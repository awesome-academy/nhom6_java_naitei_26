# Container images
MYSQL_IMAGE=mysql:8.0
MINIO_IMAGE=quay.io/minio/minio:latest
REDIS_IMAGE=redis:7.4.10-alpine

# Bind published ports to the local machine only by default
HOST_BIND_ADDRESS=127.0.0.1

# MySQL
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_management
MYSQL_USER=hotel_app
MYSQL_PASSWORD=replace_with_a_strong_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_mysql_root_password

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hotel_minio_admin
MINIO_ROOT_PASSWORD=replace_with_a_strong_minio_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=hotel_minio_admin
MINIO_SECRET_KEY=replace_with_a_strong_minio_password
MINIO_ROOM_IMAGES_BUCKET=room-images
MINIO_INVOICES_BUCKET=invoices
MINIO_INVOICE_PDF_URL_TTL=1h

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_strong_redis_password

# Auth
JWT_SECRET=replace_with_at_least_32_bytes_random_secret
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=7d
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION=15m

# Guest Document Security
GUEST_DOCUMENT_ENCRYPTION_KEY=your_32_byte_aes_key_here_for_dev!
GUEST_DOCUMENT_LOOKUP_HMAC_KEY=your_32_byte_hmac_key_here_for_dev

# Mail configuration
# Local development without an SMTP server can use: dev-email-logging
# SPRING_PROFILES_ACTIVE=dev-email-logging
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Frontend URLs
FRONTEND_VERIFY_URL=http://localhost:3000/verify-email
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# SePay payment gateway (Sandbox)
# Register at my.sepay.vn, activate Payment Gateway, then choose Sandbox to obtain these values.
PAYMENT_DEFAULT_PROVIDER=SEPAY
SEPAY_CHECKOUT_ENDPOINT=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# SePay requires public HTTPS callback URLs. Use a tunnel for local development.
SEPAY_SUCCESS_URL=https://your-public-domain.example/payment/success
SEPAY_ERROR_URL=https://your-public-domain.example/payment/error
SEPAY_CANCEL_URL=https://your-public-domain.example/payment/cancel
# Configure this endpoint in SePay Dashboard: Payment Gateway > Configuration > IPN.
SEPAY_IPN_URL=https://your-public-domain.example/api/payments/callback/sepay

# Backend (.env hoặc export)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/google/callback
